const params = new URLSearchParams(window.location.search);
const seasonId = params.get("id");

Promise.all([
  fetch("data/matches.json").then(r => r.json()),
  fetch("data/teams.json").then(r => r.json()),
  fetch("data/seasons.json").then(r => r.json())
]).then(([matches, teams, seasons]) => {

  const season = seasons.find(s => s.id === seasonId);
  document.getElementById("seasonTitle").textContent = season.name;

  const seasonMatches = matches.filter(m => m.season_id === seasonId);

  const matchDiv = document.getElementById("matches");

  seasonMatches.forEach(m => {
    const el = document.createElement("div");
    el.innerHTML = `
      <a href="match.html?id=${m.id}">
        ${m.date} - ${m.home_team} ${m.home_score}-${m.away_score} ${m.away_team}
      </a>
    `;
    matchDiv.appendChild(el);
  });

  // Build league table
  const table = {};

  seasonMatches.forEach(m => {

    if (!table[m.home_team]) table[m.home_team] = { pts: 0, gd: 0 };
    if (!table[m.away_team]) table[m.away_team] = { pts: 0, gd: 0 };

    const diff = m.home_score - m.away_score;

    table[m.home_team].gd += diff;
    table[m.away_team].gd -= diff;

    if (diff > 0) table[m.home_team].pts += 3;
    else if (diff < 0) table[m.away_team].pts += 3;
    else {
      table[m.home_team].pts += 1;
      table[m.away_team].pts += 1;
    }
  });

  const tbody = document.querySelector("#table tbody");

  Object.entries(table)
    .sort((a, b) => b[1].pts - a[1].pts)
    .forEach(([teamId, stats]) => {

      const team = teams.find(t => t.id === teamId);

      const row = document.createElement("tr");
      row.innerHTML = `
        <td>${team.name}</td>
        <td>${stats.pts}</td>
        <td>${stats.gd}</td>
      `;

      tbody.appendChild(row);
    });

});